4.Problem
What is the output of the following code snippet?
#include <stdio.h>
int main() 
{
    int x = 5;
    int y = ++x * x++;
    printf("x = %d, y = %d\n", x, y);
    return 0;
}

5.Problem
What will be printed by the following program?
#include <stdio.h>
int main() 
{
    int a = 0, b = 10, c = 20;
    
    if (a++ && ++b) {
        c += 5;
    }
    
    printf("a = %d, b = %d, c = %d\n", a, b, c);
    return 0;
}

