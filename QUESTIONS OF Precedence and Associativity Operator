1.Problem :
What will be the values of x, y, and z?
#include <stdio.h>
int main() 
{
    int x, y, z;
    x = y = z = 10 + 5 * 2;
    printf("x = %d, y = %d, z = %d\n", x, y, z);
    return 0;
}

2.Problem :
#include <stdio.h>
int main()
{
    int a = 3, b = 2, c = 1;
    int val = a > b ? a++ : b++;
    int res = val + c << 2;
    
    printf("val = %d, res = %d, a = %d\n", val, res, a);
